---
import projectsData from '../../data/projects.json';
import { AnimatedSection } from '../ui/AnimatedSection';
import { ProjectsCarousel } from './ProjectsCarousel';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const featuredProjects = projectsData.filter(p => p.featured !== false);
const remainingCount = projectsData.length - featuredProjects.length;
const allProjectsUrl = lang === 'es' ? '/es/projects' : '/projects';

const labels = {
  viewDetails: t("projects.viewDetails"),
  featuredBadge: t("projects.featuredBadge"),
  personalBadge: t("projects.personalBadge"),
  downloadApk: t("projects.downloadApk"),
  remainingCount,
};
---

<section id="projects" class="py-24 border-t border-border/20">
  <AnimatedSection client:visible>
    <div class="mb-14">
      <h2 class="text-4xl md:text-5xl font-black mb-4 text-foreground text-center tracking-tight">
        {t("projects.title")}
      </h2>
      <div class="h-1.5 w-24 bg-gradient-main mx-auto rounded-full"></div>
    </div>
  </AnimatedSection>

  <AnimatedSection client:visible delay={0.1}>
    <ProjectsCarousel
      client:visible
      projects={featuredProjects}
      lang={lang}
      labels={labels}
      allProjectsUrl={allProjectsUrl}
    />
  </AnimatedSection>
</section>
