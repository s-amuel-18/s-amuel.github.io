---
import projectsData from '../../data/projects.json';
import { AnimatedSection } from '../ui/AnimatedSection';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const FEATURED_LIMIT = 3;
const featuredProjects = projectsData.filter(p => p.featured !== false);
const projects = featuredProjects.slice(0, FEATURED_LIMIT);
const remainingCount = projectsData.length - projects.length;
const allProjectsUrl = lang === 'es' ? '/es/projects' : '/projects';

const techIcons: Record<string, string> = {
  "Node.js": "logos:nodejs-icon",
  "NestJS": "logos:nestjs",
  "TypeScript": "logos:typescript-icon",
  "JavaScript": "logos:javascript",
  "Next.js": "logos:nextjs-icon",
  "React.js": "logos:react",
  "MongoDB": "logos:mongodb-icon",
  "PostgreSQL": "logos:postgresql",
  "MySQL": "logos:mysql",
  "Redis": "logos:redis",
  "RabbitMQ": "logos:rabbitmq-icon",
  "AWS": "logos:aws",
  "PHP": "logos:php",
  "Laravel": "logos:laravel",
  "TypeORM": "logos:typeorm",
  "Jest": "logos:jest",
  "Docker": "logos:docker-icon"
};

const getIcon = (tech: string) => techIcons[tech] || "lucide:code";
---

<section id="projects" class="py-24 border-t border-border/20">
  <AnimatedSection client:visible>
    <div class="mb-16">
      <h2 class="text-4xl md:text-5xl font-black mb-4 text-foreground text-center tracking-tight">
        {t("projects.title")}
      </h2>
      <div class="h-1.5 w-24 bg-gradient-main mx-auto rounded-full"></div>
    </div>
  </AnimatedSection>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
    {projects.map((project, index) => (
      <AnimatedSection client:visible delay={index * 0.1}>
        <div class="group relative glass rounded-3xl overflow-hidden flex flex-col h-full shadow-2xl glass-hover">
          <!-- Project Image -->
          <div class="h-64 w-full overflow-hidden relative">
            <div class="absolute inset-0 bg-accent-cyan/10 opacity-0 group-hover:opacity-40 transition-opacity z-10 pointer-events-none"></div>
            <img
              src={project.image}
              alt={project.title}
              transition:name={`project-img-${project.id}`}
              class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-1000"
            />
            <div class="absolute bottom-4 left-4 z-20">
              <span class="px-3 py-1 bg-background/60 backdrop-blur-xl border border-border/40 text-accent-cyan text-[10px] font-bold font-mono rounded-lg uppercase tracking-wider">
                {project.language}
              </span>
            </div>
          </div>

          <!-- Content -->
          <div class="p-6 flex flex-col flex-grow relative">
            <div class="flex justify-between items-start mb-3">
              <h3 class="text-xl font-black text-foreground group-hover:text-accent-cyan transition-colors tracking-tight pr-2">
                {project.title}
              </h3>
              <div class="flex gap-2 text-xs text-muted-foreground font-bold shrink-0">
                <span class="flex items-center gap-1 bg-white/5 px-2 py-1 rounded-md border border-white/5">
                  <span class="text-yellow-500">★</span> {project.stars}
                </span>
                <span class="flex items-center gap-1 bg-white/5 px-2 py-1 rounded-md border border-white/5">
                  <span class="text-accent-indigo">⑂</span> {project.forks}
                </span>
              </div>
            </div>

            <p class="text-muted-foreground leading-relaxed mb-6 flex-grow font-medium text-sm">
              {project.description[lang]}
            </p>

            <!-- Tech stack -->
            <div class="flex flex-wrap gap-1.5 mb-6">
              {project.tech.slice(0, 4).map(tech => (
                <span class="flex items-center gap-1.5 px-2.5 py-1 bg-accent-cyan/5 text-accent-cyan text-[10px] font-bold rounded-lg border border-accent-cyan/10 uppercase tracking-widest cursor-default group/tech">
                  <iconify-icon icon={getIcon(tech)} class="text-sm group-hover/tech:scale-110 transition-transform"></iconify-icon>
                  {tech}
                </span>
              ))}
              {project.tech.length > 4 && (
                <span class="flex items-center px-2.5 py-1 bg-white/5 text-muted-foreground text-[10px] font-bold rounded-lg border border-white/5">
                  +{project.tech.length - 4}
                </span>
              )}
            </div>

            <!-- Links -->
            <div class="flex items-center gap-6 mt-auto">
              <a
                href={lang === 'es' ? `/es/projects/${project.id}` : `/projects/${project.id}`}
                class="text-xs font-black text-accent-cyan hover:text-white flex items-center gap-2 transition-all group/link"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="group-hover/link:translate-x-1 transition-transform"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                <span class="border-b-2 border-accent-cyan group-hover/link:border-white transition-all">{t("projects.viewDetails")}</span>
              </a>
            </div>
          </div>
        </div>
      </AnimatedSection>
    ))}
  </div>

  <!-- View More Button -->
  {remainingCount > 0 && (
    <AnimatedSection client:visible delay={0.4}>
      <div class="flex justify-center mt-14">
        <a
          href={allProjectsUrl}
          class="group relative inline-flex items-center gap-3 px-8 py-4 glass rounded-2xl glass-hover text-sm font-bold text-foreground transition-all duration-300 hover:text-accent-cyan border border-border hover:border-border-accent"
        >
          <span class="font-mono text-xs bg-accent-cyan/10 text-accent-cyan px-2.5 py-1 rounded-lg border border-accent-cyan/20 group-hover:bg-accent-cyan/15 transition-colors">
            +{remainingCount}
          </span>
          <span>
            {lang === 'es'
              ? `Ver ${remainingCount} proyecto${remainingCount !== 1 ? 's' : ''} más`
              : `View ${remainingCount} more project${remainingCount !== 1 ? 's' : ''}`}
          </span>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-1 transition-transform"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </AnimatedSection>
  )}
</section>
