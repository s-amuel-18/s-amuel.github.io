---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/layout/Header.astro';
import Footer from '../../../components/layout/Footer.astro';
import { AnimatedSection } from '../../../components/ui/AnimatedSection';
import { useTranslations } from '../../../i18n/utils';
import projectsData from '../../../data/projects.json';

const lang = 'es';
const t = useTranslations(lang);

const techIcons: Record<string, string> = {
  "Node.js": "logos:nodejs-icon",
  "NestJS": "logos:nestjs",
  "TypeScript": "logos:typescript-icon",
  "JavaScript": "logos:javascript",
  "Next.js": "logos:nextjs-icon",
  "React.js": "logos:react",
  "MongoDB": "logos:mongodb-icon",
  "PostgreSQL": "logos:postgresql",
  "MySQL": "logos:mysql",
  "Redis": "logos:redis",
  "RabbitMQ": "logos:rabbitmq-icon",
  "AWS": "logos:aws",
  "PHP": "logos:php",
  "Laravel": "logos:laravel",
  "TypeORM": "logos:typeorm",
  "Jest": "logos:jest",
  "Docker": "logos:docker-icon"
};
const getIcon = (tech: string) => techIcons[tech] || "lucide:code";

const allTechs = [...new Set(projectsData.flatMap(p => p.tech))];
const featuredCount = projectsData.filter(p => p.featured !== false).length;
const opensourceCount = projectsData.filter(p => p.github).length;
const personalCount = projectsData.filter(p => p.type === 'personal').length;

const homeUrl = '/es';
---

<BaseLayout
  title={`${t("projects.allTitle")} — Samuel Graterol`}
  description={t("projects.allSubtitle")}
>
  <Header />

  <main class="mx-auto max-w-6xl px-6 md:px-12 pt-32 pb-24">

    <!-- Back link -->
    <AnimatedSection client:visible>
      <a
        href={homeUrl}
        class="inline-flex items-center gap-2 text-muted-foreground hover:text-accent-cyan font-bold text-sm transition-colors mb-12 group"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="group-hover:-translate-x-1 transition-transform"><path d="m15 18-6-6 6-6"/></svg>
        {t("projects.back")}
      </a>
    </AnimatedSection>

    <!-- Hero -->
    <AnimatedSection client:visible delay={0.05}>
      <div class="text-center pb-16 relative">
        <div class="absolute top-[-20%] left-1/2 -translate-x-1/2 w-[70%] h-full bg-gradient-glow opacity-40 pointer-events-none -z-10 blur-3xl"></div>

        <h1 class="text-5xl md:text-7xl lg:text-8xl font-black text-gradient mb-6 tracking-tight leading-none pb-2">
          {t("projects.allTitle")}
        </h1>

        <p class="text-muted-foreground text-lg max-w-2xl mx-auto mb-14 leading-relaxed">
          {t("projects.allSubtitle")}
        </p>

        <div class="flex items-center justify-center gap-4 flex-wrap">
          <div class="glass px-7 py-4 rounded-2xl text-center glass-hover">
            <div class="text-4xl font-black text-accent-cyan leading-none mb-1">{projectsData.length}</div>
            <div class="text-[11px] text-muted-foreground uppercase tracking-[0.15em] font-bold">{t("projects.statsProjects")}</div>
          </div>
          <div class="w-px h-10 bg-border/40 hidden sm:block"></div>
          <div class="glass px-7 py-4 rounded-2xl text-center glass-hover">
            <div class="text-4xl font-black text-accent-indigo leading-none mb-1">{allTechs.length}+</div>
            <div class="text-[11px] text-muted-foreground uppercase tracking-[0.15em] font-bold">{t("projects.statsTechs")}</div>
          </div>
          <div class="w-px h-10 bg-border/40 hidden sm:block"></div>
          <div class="glass px-7 py-4 rounded-2xl text-center glass-hover">
            <div class="text-4xl font-black text-accent-violet leading-none mb-1">{featuredCount}</div>
            <div class="text-[11px] text-muted-foreground uppercase tracking-[0.15em] font-bold">{t("projects.filterFeatured")}</div>
          </div>
        </div>
      </div>
    </AnimatedSection>

    <!-- Filter bar -->
    <AnimatedSection client:visible delay={0.15}>
      <div id="filter-bar" class="flex flex-wrap gap-3 mb-12">
        <button
          data-filter="all"
          class="filter-btn filter-active inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-bold transition-all duration-200 border glass"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/></svg>
          {t("projects.filterAll")}
          <span class="font-mono text-[10px] px-1.5 py-0.5 rounded-md bg-current/10">{projectsData.length}</span>
        </button>
        <button
          data-filter="featured"
          class="filter-btn inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-bold transition-all duration-200 border glass"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          {t("projects.filterFeatured")}
          <span class="font-mono text-[10px] px-1.5 py-0.5 rounded-md bg-current/10">{featuredCount}</span>
        </button>
        <button
          data-filter="opensource"
          class="filter-btn inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-bold transition-all duration-200 border glass"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
          {t("projects.filterOpenSource")}
          <span class="font-mono text-[10px] px-1.5 py-0.5 rounded-md bg-current/10">{opensourceCount}</span>
        </button>
        {personalCount > 0 && (
          <button
            data-filter="personal"
            class="filter-btn inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-bold transition-all duration-200 border glass"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            {t("projects.filterPersonal")}
            <span class="font-mono text-[10px] px-1.5 py-0.5 rounded-md bg-current/10">{personalCount}</span>
          </button>
        )}
      </div>
    </AnimatedSection>

    <!-- Projects grid -->
    <div id="projects-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {projectsData.map((project, index) => (
        <AnimatedSection client:visible delay={index * 0.07}>
          <div
            data-project-card
            data-featured={project.featured !== false ? 'true' : 'false'}
            data-opensource={project.github ? 'true' : 'false'}
            data-personal={project.type === 'personal' ? 'true' : 'false'}
            class="project-card group relative glass rounded-3xl overflow-hidden flex flex-col h-full shadow-2xl glass-hover"
          >
            {project.image ? (
              <div class="project-media h-44 w-full overflow-hidden relative bg-bg-secondary">
                <!-- Blurred ambient backdrop -->
                <img
                  src={project.image}
                  alt=""
                  aria-hidden="true"
                  class="absolute inset-0 w-full h-full object-cover scale-[1.35] blur-2xl opacity-55 transition-transform duration-[1500ms] ease-out group-hover:scale-150"
                />
                <!-- Brand tint + vignette -->
                <div class="absolute inset-0 bg-gradient-to-br from-accent-cyan/[0.06] via-transparent to-accent-indigo/[0.06] z-[2] pointer-events-none"></div>
                <div class="absolute inset-0 bg-gradient-to-t from-background/40 via-transparent to-transparent z-[3] pointer-events-none"></div>
                <!-- Featured / Personal badges -->
                <div class="absolute top-3 right-3 z-20 flex flex-col gap-2 items-end">
                  {project.featured !== false && (
                    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-accent-cyan/90 backdrop-blur-sm text-primary-foreground text-[10px] font-black font-mono rounded-lg uppercase tracking-wider shadow-glow-cyan">
                      <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                      {t("projects.featuredBadge")}
                    </span>
                  )}
                  {project.type === 'personal' && (
                    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-accent-violet/90 backdrop-blur-sm text-primary-foreground text-[10px] font-black font-mono rounded-lg uppercase tracking-wider shadow-lg">
                      <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                      {t("projects.personalBadge")}
                    </span>
                  )}
                </div>
                <!-- Foreground image (full image, not cropped) -->
                <div class="relative w-full h-full flex items-center justify-center p-3 z-[10]">
                  <img
                    src={project.image}
                    alt={project.title}
                    class="max-w-full max-h-full object-contain drop-shadow-[0_8px_20px_rgba(0,0,0,0.45)] rounded-lg transform group-hover:scale-[1.04] transition-transform duration-700 ease-out"
                  />
                </div>
                <!-- Hover tint -->
                <div class="absolute inset-0 bg-accent-cyan/10 opacity-0 group-hover:opacity-30 transition-opacity z-[15] pointer-events-none"></div>
                <div class="absolute bottom-3 left-3 z-20">
                  <span class="px-2.5 py-1 bg-background/70 backdrop-blur-xl border border-border/40 text-accent-cyan text-[10px] font-bold font-mono rounded-lg uppercase tracking-wider">
                    {project.language}
                  </span>
                </div>
              </div>
            ) : (
              <div class="h-44 w-full relative overflow-hidden bg-bg-secondary">
                <div
                  class="absolute inset-0 opacity-[0.06]"
                  style="background-image: linear-gradient(rgba(34,211,238,1) 1px, transparent 1px), linear-gradient(90deg, rgba(34,211,238,1) 1px, transparent 1px); background-size: 28px 28px;"
                ></div>
                <div class="absolute inset-0 bg-gradient-to-br from-accent-indigo/10 to-accent-violet/5"></div>
                <div class="absolute inset-0 flex items-center justify-center">
                  <pre class="font-mono text-[11px] leading-relaxed select-none text-left pointer-events-none" style="color: rgba(148,163,184,0.25);">{`const project = {
  lang: "${project.language}",
  type: "open-source",
  status: "active"
}`}</pre>
                </div>
                <div class="absolute top-3 right-3 z-20">
                  <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-accent-indigo/20 border border-accent-indigo/30 text-accent-indigo text-[10px] font-black rounded-lg uppercase tracking-wider">
                    <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
                    Open Source
                  </span>
                </div>
                <div class="absolute bottom-3 left-3 z-20">
                  <span class="px-2.5 py-1 bg-background/70 backdrop-blur-xl border border-border/40 text-accent-cyan text-[10px] font-bold font-mono rounded-lg uppercase tracking-wider">
                    {project.language}
                  </span>
                </div>
              </div>
            )}

            <div class="p-6 flex flex-col flex-grow">
              <div class="flex justify-between items-start mb-2">
                <h3 class="text-lg font-black text-foreground group-hover:text-accent-cyan transition-colors tracking-tight pr-2 leading-tight">
                  {project.title}
                </h3>
                {((project.stars ?? 0) > 0 || (project.forks ?? 0) > 0) && (
                  <div class="flex gap-2 text-[11px] text-muted-foreground font-bold shrink-0">
                    {(project.stars ?? 0) > 0 && (
                      <span class="flex items-center gap-1 bg-white/5 px-2 py-1 rounded-md border border-white/5">
                        <span class="text-yellow-500">★</span> {project.stars}
                      </span>
                    )}
                    {(project.forks ?? 0) > 0 && (
                      <span class="flex items-center gap-1 bg-white/5 px-2 py-1 rounded-md border border-white/5">
                        <span class="text-accent-indigo">⑂</span> {project.forks}
                      </span>
                    )}
                  </div>
                )}
              </div>

              <p class="text-muted-foreground leading-relaxed mb-5 flex-grow font-medium text-sm">
                {project.description[lang]}
              </p>

              <div class="flex flex-wrap gap-1.5 mb-5">
                {project.tech.slice(0, 4).map(tech => (
                  <span class="flex items-center gap-1 px-2 py-0.5 bg-white/5 text-muted-foreground text-[10px] font-bold rounded-md border border-white/5 uppercase tracking-wide">
                    <iconify-icon icon={getIcon(tech)} class="text-xs"></iconify-icon>
                    {tech}
                  </span>
                ))}
                {project.tech.length > 4 && (
                  <span class="px-2 py-0.5 bg-white/5 text-muted-foreground text-[10px] font-bold rounded-md border border-white/5">
                    +{project.tech.length - 4}
                  </span>
                )}
              </div>

              <div class="flex items-center gap-5 mt-auto flex-wrap">
                {project.content && (
                  <a
                    href={`/es/projects/${project.id}`}
                    class="text-xs font-black text-accent-cyan hover:text-white flex items-center gap-1.5 transition-all group/link"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="group-hover/link:translate-x-0.5 transition-transform"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                    <span class="border-b border-accent-cyan/50 group-hover/link:border-white transition-all">{t("projects.viewDetails")}</span>
                  </a>
                )}
                {project.github && (
                  <a
                    href={project.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-xs font-bold text-muted-foreground hover:text-accent-indigo flex items-center gap-1.5 transition-all"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
                    {t("projects.github")}
                  </a>
                )}
                {project.projectUrl && (
                  <a
                    href={project.projectUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-xs font-bold text-muted-foreground hover:text-accent-violet flex items-center gap-1.5 transition-all"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
                    Demo
                  </a>
                )}
                {project.apk && (
                  <a
                    href={project.apk}
                    download
                    class="text-xs font-bold text-muted-foreground hover:text-accent-violet flex items-center gap-1.5 transition-all"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
                    {t("projects.downloadApk")}
                  </a>
                )}
              </div>
            </div>
          </div>
        </AnimatedSection>
      ))}
    </div>

    <!-- No results state -->
    <div id="no-results" class="hidden text-center py-24">
      <div class="text-muted-foreground/40 text-6xl mb-6">◌</div>
      <p class="text-muted-foreground font-bold text-lg">{t("projects.noResults")}</p>
    </div>

  </main>

  <Footer />
</BaseLayout>

<style>
  .filter-btn {
    color: var(--muted-foreground);
    border-color: var(--border);
  }
  .filter-btn:hover {
    color: var(--foreground);
    border-color: rgba(34, 211, 238, 0.3);
  }
  .filter-active {
    color: var(--accent-cyan) !important;
    border-color: rgba(34, 211, 238, 0.4) !important;
    background-color: rgba(34, 211, 238, 0.05) !important;
  }

  @keyframes cardIn {
    from { opacity: 0; transform: translateY(8px) scale(0.98); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  .project-card {
    animation: cardIn 0.3s ease forwards;
  }
</style>

<script is:inline>
  (function () {
    const filterBtns = document.querySelectorAll('[data-filter]');
    const cards = document.querySelectorAll('[data-project-card]');
    const noResults = document.getElementById('no-results');

    function applyFilter(filter) {
      let visibleCount = 0;

      filterBtns.forEach(btn => {
        btn.classList.toggle('filter-active', btn.dataset.filter === filter);
      });

      cards.forEach(card => {
        const show =
          filter === 'all' ||
          (filter === 'featured' && card.dataset.featured === 'true') ||
          (filter === 'opensource' && card.dataset.opensource === 'true') ||
          (filter === 'personal' && card.dataset.personal === 'true');

        if (show) {
          card.style.removeProperty('display');
          const el = card;
          el.style.animation = 'none';
          el.offsetWidth;
          el.style.removeProperty('animation');
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (noResults) noResults.classList.toggle('hidden', visibleCount > 0);
    }

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => applyFilter(btn.dataset.filter || 'all'));
    });
  })();
</script>
